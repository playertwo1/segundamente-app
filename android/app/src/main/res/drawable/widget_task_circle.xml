<?xml version="1.0" encoding="utf-8"?>
<!-- F15-05: the task circle. The 7 dp inset keeps a 36 dp touch target around a 22 dp ring. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="7dp">
    <shape android:shape="oval">
        <stroke
            android:width="2dp"
            android:color="@color/widget_ivory" />
    </shape>
</inset>
