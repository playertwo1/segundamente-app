<?xml version="1.0" encoding="utf-8"?>
<!-- F15-05: 20dp soft ring centered via ImageView scaleType="center" inside a 48dp touch target. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <size
        android:width="20dp"
        android:height="20dp" />
    <stroke
        android:width="1.6dp"
        android:color="@color/widget_ring" />
</shape>
