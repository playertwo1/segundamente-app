<?xml version="1.0" encoding="utf-8"?>
<!-- F15-04: the chat keys (Conversar, Falar), shared by the small and medium widget (D-064). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_chat_type"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_key_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:minHeight="48dp"
        android:text="@string/shortcut_chat_type"
        android:textColor="@color/widget_black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_chat_talk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_key_outline"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:minHeight="48dp"
        android:text="@string/shortcut_chat_talk"
        android:textColor="@color/widget_ivory"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
