<?xml version="1.0" encoding="utf-8"?>
<!-- F15-03+: Tier 1 chat keys (Conversar, Falar), borderless warm surfaces with >=48dp targets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/widget_chat_type"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_key_primary"
        android:clickable="true"
        android:contentDescription="@string/shortcut_chat_type"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/widget_key_height"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_chat" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/shortcut_chat_type"
            android:textColor="@color/widget_black"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_chat_talk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/widget_key_gap"
        android:layout_weight="1"
        android:background="@drawable/widget_key_talk"
        android:clickable="true"
        android:contentDescription="@string/shortcut_chat_talk"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/widget_key_height"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_mic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/shortcut_chat_talk"
            android:textColor="@color/widget_ivory"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
