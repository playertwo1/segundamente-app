<?xml version="1.0" encoding="utf-8"?>
<!-- F15-04+: medium widget (chat keys + capture keys: Anotar, Foto, Colar). Concentric AMOLED layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_padding_horizontal"
    android:paddingTop="@dimen/widget_padding_vertical"
    android:paddingEnd="@dimen/widget_padding_horizontal"
    android:paddingBottom="@dimen/widget_padding_vertical">

    <include
        layout="@layout/widget_chat_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include
        layout="@layout/widget_capture_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/widget_key_gap"
        android:layout_weight="1" />
</LinearLayout>
