<?xml version="1.0" encoding="utf-8"?>
<!-- Medium widget (>=250dp wide): optional compact header (>=160dp height), 4 quick-capture tiles, and input CTA bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_padding_horizontal"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/widget_padding_horizontal"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/widget_medium_header"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/widget_open_app"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_row_ripple"
            android:clickable="true"
            android:contentDescription="@string/widget_open_app"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_logo_badge"
                android:clipToOutline="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sm_launcher_foreground" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_label"
                android:textColor="@color/widget_ivory"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_open_external"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_row_ripple"
            android:clickable="true"
            android:contentDescription="@string/widget_open_app"
            android:focusable="true"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_open_ext" />
    </LinearLayout>

    <include
        layout="@layout/widget_capture_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_key_height"
        android:layout_marginTop="@dimen/widget_key_gap"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_chat_type"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_input_box"
            android:clickable="true"
            android:contentDescription="@string/widget_input_hint"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/widget_key_height"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <FrameLayout
                android:layout_width="2dp"
                android:layout_height="16dp"
                android:background="@drawable/widget_cursor_amber" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="@string/widget_input_hint"
                android:textColor="@color/widget_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_register_btn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/widget_key_gap"
            android:background="@drawable/widget_key_primary"
            android:clickable="true"
            android:contentDescription="@string/widget_register_cta"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/widget_key_height"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_register_cta"
                android:textColor="@color/widget_dark_ink"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="5dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_arrow_right" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
