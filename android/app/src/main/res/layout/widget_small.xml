<?xml version="1.0" encoding="utf-8"?>
<!-- F15-03: small widget, two keys in one strip (D-064). Only RemoteViews-safe views here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_chat_type"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_key_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:minHeight="48dp"
        android:text="@string/shortcut_chat_type"
        android:textColor="@color/widget_black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_chat_talk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_key_outline"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:minHeight="48dp"
        android:text="@string/shortcut_chat_talk"
        android:textColor="@color/widget_ivory"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
