<?xml version="1.0" encoding="utf-8"?>
<!-- v3 task row inside the nested section card: 18dp green/amber circle inside 48dp touch target, crisp ivory title, inset hairline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="@dimen/widget_key_height"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_task_check"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_row_ripple"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="@dimen/widget_key_height"
            android:scaleType="center"
            android:src="@drawable/widget_task_circle" />

        <TextView
            android:id="@+id/widget_task_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_row_ripple"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:lineSpacingMultiplier="1.12"
            android:maxLines="2"
            android:minHeight="@dimen/widget_key_height"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:textColor="@color/widget_ivory"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/widget_task_time"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingEnd="6dp"
            android:textColor="@color/widget_secondary"
            android:textSize="11.5sp" />
    </LinearLayout>

    <View
        android:id="@+id/widget_task_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="6dp"
        android:background="@color/widget_line" />
</LinearLayout>
