<?xml version="1.0" encoding="utf-8"?>
<!-- F15-05: large widget, D-064 "linhas": the chat and capture rows, up to three of today's tasks, "+ tarefa". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="6dp">

    <include
        layout="@layout/widget_chat_row"
        android:layout_width="match_parent"
        android:layout_height="44dp" />

    <include
        layout="@layout/widget_capture_row"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <!-- Rows are added at runtime (RemoteViews.addView), overdue first. -->
        <LinearLayout
            android:id="@+id/widget_tasks_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/widget_tasks_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_tasks_empty"
            android:textColor="@color/widget_ivory"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_task_add"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_key_outline"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_key_task_add"
        android:textColor="@color/widget_ivory"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
