<?xml version="1.0" encoding="utf-8"?>
<!-- 4 equal quick-capture tiles matching reference mockup: Falar, Anotar, Foto, Colar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/widget_chat_talk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_key_outline"
        android:clickable="true"
        android:contentDescription="@string/shortcut_chat_talk"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/widget_key_height"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_mic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/shortcut_chat_talk"
            android:textColor="@color/widget_ivory_soft"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_capture_note"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/widget_key_gap"
        android:layout_weight="1"
        android:background="@drawable/widget_key_outline"
        android:clickable="true"
        android:contentDescription="@string/widget_key_note"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/widget_key_height"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_note" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_key_note"
            android:textColor="@color/widget_ivory_soft"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_capture_photo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/widget_key_gap"
        android:layout_weight="1"
        android:background="@drawable/widget_key_outline"
        android:clickable="true"
        android:contentDescription="@string/widget_key_photo"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/widget_key_height"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_photo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_key_photo"
            android:textColor="@color/widget_ivory_soft"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_capture_paste"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/widget_key_gap"
        android:layout_weight="1"
        android:background="@drawable/widget_key_outline"
        android:clickable="true"
        android:contentDescription="@string/widget_key_paste"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/widget_key_height"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_paste" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_key_paste"
            android:textColor="@color/widget_ivory_soft"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
