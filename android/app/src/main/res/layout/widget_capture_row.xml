<?xml version="1.0" encoding="utf-8"?>
<!-- F15-04: capture keys Anotar, Foto, Colar (D-064). Outlined, so the chat keys stay the lead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_capture_note"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_key_outline"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:minHeight="48dp"
        android:text="@string/widget_key_note"
        android:textColor="@color/widget_ivory"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_capture_photo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_key_outline"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:minHeight="48dp"
        android:text="@string/widget_key_photo"
        android:textColor="@color/widget_ivory"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_capture_paste"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_key_outline"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:minHeight="48dp"
        android:text="@string/widget_key_paste"
        android:textColor="@color/widget_ivory"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
